# Build context is the repository root (see docker-compose.yml), so keep the
# image builds small and reproducible by excluding local dev artefacts.
.git
.gitignore
.venv
venv
**/__pycache__
**/*.pyc
**/.pytest_cache
backend/dev.db
backend/*.log
.env
Resource_Demo
k8s
powerbi
*.md
# Cover source packs (~350 MB): the generated catalog already lives in
# backend/app/db/books_catalog.json and the covers in frontend/dist.
Cover_Remake
frontend/node_modules
frontend/src
_qa_book
_srs_work
*.docx
